          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is NIXATV?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "NIXATV is a premium streaming service that allows you to watch live TV channels, movies, and series directly over the internet without the need for traditional cable or satellite."
